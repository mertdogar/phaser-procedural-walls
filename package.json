{
  "name": "@mertdogar/phaser-procedural-walls",
  "version": "0.1.0",
  "description": "Phaser 4 scene plugin that renders procedural top-down walls with faces, see-through windows, depth sorting and Arcade colliders from wall centerline data.",
  "keywords": [
    "phaser",
    "phaser4",
    "phaser-plugin",
    "procedural",
    "walls",
    "floorplan",
    "top-down",
    "tilemap",
    "game"
  ],
  "author": "Mert Dogar <mertdogar@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mertdogar/phaser-procedural-walls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertdogar/phaser-procedural-walls.git"
  },
  "bugs": {
    "url": "https://github.com/mertdogar/phaser-procedural-walls/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "phaser-procedural-walls": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json && vite build --mode editor",
    "editor": "node bin/cli.mjs editor",
    "test:cli": "node --test tests/cli.test.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src demo tests bin",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:cli"
  },
  "peerDependencies": {
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.0.0",
    "phaser": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
